# ==============================================================================
# Sree Sakthi Engineering College - Central Smart Library
# Environment Configuration Template
# ==============================================================================
# Copy this file to '.env.local' for local development or enter these variables
# in the Vercel Project Settings (Project -> Settings -> Environment Variables).

# Institutional Branding & Contact Information
NEXT_PUBLIC_APP_NAME="SSEC Smart Library Management System"
NEXT_PUBLIC_APP_VERSION="v2.4 Smart Release"
NEXT_PUBLIC_COLLEGE_NAME="Sree Sakthi Engineering College"
NEXT_PUBLIC_COLLEGE_SHORT_NAME="Sree Sakthi Engg College"
NEXT_PUBLIC_COLLEGE_LOCATION="Coimbatore"
NEXT_PUBLIC_LIBRARY_NAME="Central Smart Library"
NEXT_PUBLIC_LIBRARY_EMAIL="library@sreesakthi.edu.in"
NEXT_PUBLIC_LIBRARY_PHONE="+91 422 236 9900"
NEXT_PUBLIC_CURRENCY_SYMBOL="₹"

# ==============================================================================
# Dual Portal Configuration
# ==============================================================================
# Both portals are active concurrently:
# - Admin Portal:   https://your-domain.vercel.app/admin
# - Student Portal: https://your-domain.vercel.app/student
# - Portal Gateway: https://your-domain.vercel.app/
#
# (Optional) Subdomain isolation:
# - If using admin.domain.com and student.domain.com, subdomains are detected automatically.
# ==============================================================================

# Library Circulation Policies
NEXT_PUBLIC_DEFAULT_LOAN_DAYS="14"
NEXT_PUBLIC_FINE_PER_DAY="5"
NEXT_PUBLIC_MAX_BOOKS_PER_STUDENT="3"

# Supabase Authentication & Database Configuration
# Obtain these from your Supabase Project: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-publishable-key"

# Backend PostgreSQL Database Configuration (Server-Side Only)
PGHOST="aws-0-ap-northeast-2.pooler.supabase.com"
PGPORT="5432"
PGDATABASE="postgres"
PGUSER="postgres.your-project-id"
PGPASSWORD="your-database-password"

DB_HOST="aws-0-ap-northeast-2.pooler.supabase.com"
DB_PORT="5432"
DB_NAME="postgres"
DB_USER="postgres.your-project-id"
DB_PASSWORD="your-database-password"

DATABASE_URL="postgresql://postgres.your-project-id:your-password@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres"
POSTGRES_URL="postgresql://postgres.your-project-id:your-password@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres"

# Optional: Supabase Service Role Key (SERVER-SIDE ONLY - NEVER EXPOSE AS NEXT_PUBLIC)
# Used only by /api/admin/create-student to provision student accounts with auto-confirmation.
# SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

